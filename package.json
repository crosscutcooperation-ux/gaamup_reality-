{
  "name": "aero-property-discovery",
  "version": "3.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/frontend.mjs dev",
    "dev:backend": "node scripts/rust.mjs run",
    "build": "next build",
    "start": "node scripts/dev.mjs --production",
    "start:frontend": "node scripts/frontend.mjs start",
    "test": "node --test tests/*.test.mjs",
    "test:backend": "node scripts/rust.mjs test",
    "check": "npm test && npm run test:backend && npm run build",
    "test:http": "node scripts/smoke.mjs",
    "admin:key": "node scripts/admin-key.mjs",
    "model:export": "node scripts/build-model.mjs",
    "model:render": "node scripts/build-model.mjs --render",
    "test:uploads": "node scripts/smoke-uploads.mjs",
    "build:scenes": "node scripts/bundle-scenes.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "esbuild": "0.28.2",
    "happy-dom": "^21.0.4"
  }
}
